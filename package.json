{
  "name": "acmeu",
  "version": "3.14.2",
  "private": true,
  "description": "AcmeU learning and credentialing platform",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @acmeu/shared && npm run build --workspace @acmeu/api && npm run build --workspace @acmeu/web",
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev --workspace @acmeu/api\" \"npm run dev --workspace @acmeu/web\"",
    "start": "npm run start --workspace @acmeu/api",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "typecheck": "tsc -b --pretty false",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "node scripts/migrate.mjs up",
    "db:seed": "node scripts/migrate.mjs seed",
    "db:reset": "node scripts/migrate.mjs reset",
    "stack:up": "docker compose up -d --build",
    "stack:down": "docker compose down -v"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.1",
    "pg": "^8.13.1",
    "typescript": "^5.7.2"
  }
}
