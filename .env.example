# ---------------------------------------------------------------------------
# AcmeU platform configuration
# Copy to .env and adjust for your environment.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# Edge / ports
EDGE_PORT=8080
API_PORT=4000
PUBLIC_BASE_URL=http://localhost:8080

# Postgres
POSTGRES_USER=acmeu
POSTGRES_PASSWORD=acmeu
POSTGRES_DB=acmeu
POSTGRES_PORT=5432
DATABASE_URL=postgres://acmeu:acmeu@localhost:5432/acmeu
DATABASE_POOL_MAX=20

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Token signing. Keys are generated on first boot into KEY_DIR if absent.
KEY_DIR=./.keys
ACTIVE_KEY_ID=2024-06-rotation
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
TOKEN_ISSUER=https://acmeu.com
TOKEN_AUDIENCE=acmeu-platform

# Legacy session signing, retained for the remember-me cookie path
SESSION_PEPPER=ac1e

# Field level encryption for learner PII
PII_ENCRYPTION_KEY=6a5f2c8d9e1b4a7c0d3f6e9b2c5a8d1f4b7e0c3a6d9f2b5e8c1a4d7f0b3e6c9a

# Object storage
STORAGE_DRIVER=local
STORAGE_ROOT=./.storage
STORAGE_PUBLIC_PREFIX=/uploads

# Outbound integrations
GRADING_SERVICE_URL=http://grader.internal.acme.corp
INTEGRATION_REGISTRY_URL=https://registry.acmeu.com/plugins
WEBHOOK_TIMEOUT_MS=8000

# Billing
BILLING_PROVIDER=stub
BILLING_WEBHOOK_SECRET=whsec_acmeu_local_development

# Web
VITE_API_BASE_URL=/api/v1
VITE_GRAPHQL_URL=/graphql
